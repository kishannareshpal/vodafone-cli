{
  "name": "vodafone-cli",
  "description": "Vodafone router CLI",
  "version": "0.0.0",
  "author": "Kishan Jadav",
  "bin": {
    "vodafone-cli": "./bin/run.js"
  },
  "bugs": "https://github.com/kishannareshpal/vodafone-cli/issues",
  "dependencies": {
    "@oclif/core": "^4.10.6",
    "@oclif/plugin-help": "^6.2.45",
    "@oclif/plugin-plugins": "^5.4.62"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4.1.18",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "chai": "^4.5.0",
    "eslint": "^9.39.4",
    "eslint-config-oclif": "^6.0.160",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^11.7.5",
    "oclif": "^4.23.0",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/kishannareshpal/vodafone-cli",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "vodafone-cli",
    "dirname": "vodafone-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": "kishannareshpal/vodafone-cli",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
